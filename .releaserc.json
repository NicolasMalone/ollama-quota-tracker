{
  "branches": [
    "+([0-9])?(.{+([0-9]),x}).x",
    "main",
    "next",
    { "name": "beta", "prerelease": true },
    { "name": "alpha", "prerelease": true }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "docs", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features", "hidden": false },
            { "type": "fix", "section": "Bug Fixes", "hidden": false },
            { "type": "docs", "section": "Documentation", "hidden": false },
            { "section": "Miscellaneous", "hidden": true },
            { "type": "perf", "section": "Performance Improvements", "hidden": false }
          ]
        }
      }
    ],
    ["@semantic-release/changelog", { "changelogTitle": "# Changelog" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "mkdir -p releases && vsce package --out releases/ollama-quota-tracker-${nextRelease.version}.vsix",
        "publishCmd": "if [ -n \"$VSCE_PAT\" ]; then echo 'Publishing to the VS Code Marketplace...'; vsce publish --packagePath releases/ollama-quota-tracker-${nextRelease.version}.vsix; else echo '::error::VSCE_PAT secret is not set — cannot publish to the Marketplace' && exit 1; fi"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "releases/*.vsix",
            "name": "ollama-quota-tracker-${nextRelease.version}.vsix",
            "label": "Extension VSIX (install with: code --install-extension <file>)"
          }
        ],
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}

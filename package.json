{
  "name": "ollama-quota-tracker",
  "displayName": "Ollama Quota Tracker (Unofficial)",
  "description": "Shows your Ollama Cloud quota (included credits or legacy limits) in the VS Code status bar, with usage charts and multi-token management in a dashboard.",
  "version": "0.11.0",
  "publisher": "NicolasMalone",
  "license": "MIT",
  "icon": "media/OllamyQT-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NicolasMalone/ollama-quota-tracker"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "ollama",
    "quota",
    "cloud",
    "status bar",
    "credits"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ollamaQuota.configureApiKey",
        "title": "Ollama Quota: Manage API Keys"
      },
      {
        "command": "ollamaQuota.openDashboard",
        "title": "Ollama Quota: Open Dashboard"
      },
      {
        "command": "ollamaQuota.refresh",
        "title": "Ollama Quota: Refresh"
      }
    ],
    "configuration": {
      "title": "Ollama Quota Tracker",
      "properties": {
        "ollamaQuota.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Polling interval in seconds. 0 disables automatic refresh. Values below 30 are clamped to 30 to protect the shared rate limit (10 requests/minute)."
        },
        "ollamaQuota.warnThreshold": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "maximum": 100,
          "description": "Remaining-quota threshold for the progress-bar colors. Above it bars and percentages render blue; at or below it they turn yellow, and red once remaining falls to half the threshold (the status-bar warning icon uses the same boundary). 0 keeps everything blue, or red at exactly 0."
        },
        "ollamaQuota.displayMode": {
          "type": "string",
          "enum": [
            "used",
            "remaining"
          ],
          "enumDescriptions": [
            "Show the consumed quota percentage (e.g. 58%).",
            "Show the remaining quota percentage (e.g. 42%)."
          ],
          "default": "used",
          "description": "Quota percentage shown across the extension: consumed (\"used\") or \"remaining\" — status bar, tooltip and dashboard meters all follow it."
        },
        "ollamaQuota.tooltipTimeFormat": {
          "type": "string",
          "enum": [
            "auto",
            "12h",
            "24h"
          ],
          "enumDescriptions": [
            "Follow the editor's language/region defaults (e.g. 12-hour clock in en-US).",
            "Force a 12-hour clock, e.g. `Nov 1 at 1:00 AM`.",
            "Force a 24-hour clock, e.g. `Nov 1 at 13:00`."
          ],
          "default": "auto",
          "description": "Hour format of the timestamps in the hover tooltip and the dashboard (resets, update times and chart labels)."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.config.mjs",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:tsc": "tsc --noEmit --watch --preserveWatchOutput",
    "watch:esbuild": "node esbuild.config.mjs --watch",
    "pretest": "tsc --outDir out",
    "test": "node out/test/runTest.js",
    "package": "vsce package --out releases/%npm_package_name%-%npm_package_version%.vsix",
    "shoot": "node scripts/dashboard-shot.mjs && node scripts/hover-shot.mjs",
    "publish": "vsce publish",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "vscode:prepublish": "npm run check-types && node esbuild.config.mjs --production"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "chai": "^4.5.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.7.4",
    "npm-run-all": "^4.1.5",
    "puppeteer-core": "^25.16.0",
    "semantic-release": "^25.0.9",
    "sinon": "^21.0.0",
    "typescript": "^5.9.0"
  }
}
